/packages/ferrastra/src/ferrastra/_native*.so
/packages/ferrastra/src/ferrastra/_native*.dylib

# Coverage reports
.coverage
.coverage.*
coverage.xml
junit*.xml
htmlcov/

# Logs
*.log
log.txt

# Editor and OS files
.vscode/
.idea/
*.swp
*.tmp
.DS_Store
Thumbs.db

